{
  "name": "@caiqueoak/flow",
  "version": "0.6.0",
  "description": "Readability-first, agent-agnostic software development workflow for coding agents.",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node dist/entry.js schemas",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write src test scripts skills package.json package-lock.json README.md eslint.config.js prettier.config.mjs tsconfig.json",
    "format:check": "prettier --check src test scripts skills package.json package-lock.json README.md eslint.config.js prettier.config.mjs tsconfig.json",
    "pack:check": "npm run build && npm pack --dry-run",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "flow": "./dist/entry.js"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "coding-agent",
    "agentic-development",
    "workflow",
    "skills",
    "software-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caiqueoak/flow.git"
  },
  "homepage": "https://github.com/Caiqueoak/flow#readme",
  "bugs": {
    "url": "https://github.com/Caiqueoak/flow/issues"
  },
  "license": "MIT"
}
