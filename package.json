{
  "name": "@caiqueoak/flow",
  "version": "0.3.0",
  "description": "Readability-first, agent-agnostic software development workflow for coding agents.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write src test package.json package-lock.json README.md eslint.config.js prettier.config.mjs",
    "format:check": "prettier --check src test package.json package-lock.json README.md eslint.config.js prettier.config.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "bin": {
    "flow": "./src/cli.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "coding-agent",
    "agentic-development",
    "workflow",
    "skills",
    "software-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caiqueoak/flow.git"
  },
  "homepage": "https://github.com/Caiqueoak/flow#readme",
  "bugs": {
    "url": "https://github.com/Caiqueoak/flow/issues"
  },
  "license": "MIT"
}
